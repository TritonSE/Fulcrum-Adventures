{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "node": "22.23.4",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://fulcrum-backend.vercel.app"
      },
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.2"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "node": "22.23.4",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://fulcrum-backend.vercel.app"
      },
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.2"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6838847564"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
